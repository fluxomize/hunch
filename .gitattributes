# Normalise line endings to LF in the repository and in every working copy.
# Contributors on Windows would otherwise commit CRLF and fight Prettier on every file.
* text=auto eol=lf

# Binary files must never be touched.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated files, so GitHub keeps them out of diffs and language stats.
pnpm-lock.yaml linguist-generated=true
