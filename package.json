{
  "name": "@fluxomize/hunch",
  "version": "0.0.2",
  "description": "Playwright's smart hunch about which tests to run. Predictive test selection with ML to cut CI time and carbon footprint.",
  "keywords": [
    "playwright",
    "testing",
    "test-selection",
    "ml",
    "green-software",
    "ci-cd",
    "predictive-testing"
  ],
  "homepage": "https://github.com/fluxomize/hunch",
  "bugs": "https://github.com/fluxomize/hunch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxomize/hunch.git"
  },
  "license": "Apache-2.0",
  "author": "Fluxomize <fluxomize@outlook.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter/index.d.ts",
      "import": "./dist/reporter/index.js"
    }
  },
  "bin": {
    "hunch": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ml-logistic-regression": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^10.10.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
